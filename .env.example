# HTTP 서버 설정 (npm run start:http / Docker 사용 시)
PORT=3000
HOST=0.0.0.0

# 기본 학교/학년/반 (선택 사항 - 설정하면 매번 입력하지 않아도 됨)
DEFAULT_SCHOOL=
DEFAULT_GRADE=
DEFAULT_CLASS=

# 나이스(NEIS) 교육정보 개방 포털 API 키 (선택 사항 - https://open.neis.go.kr)
NEIS_API_KEY=

# 원격 HTTP 서버 보안 설정 (외부 공개 시 설정 권장)
# 1) Bearer 인증 토큰 (Authorization 헤더 지원 클라이언트용)
MCP_AUTH_TOKEN=
# 2) 비밀 엔드포인트 경로 (예: /mcp/my-secret-key — 헤더 입력이 어려운 클라이언트용)
MCP_PATH=/mcp
# 3) CORS 허용 출처 (비워두면 교차 출처 차단)
MCP_CORS_ORIGIN=
# 4) IP당 분당 최대 요청 수
RATE_LIMIT_MAX=60
